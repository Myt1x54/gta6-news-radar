# Frontend env vars (Phase 5). Copy to web/.env.local. Safe (public) keys only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (used by the "Generate more ideas" API route; never exposed
# to the browser). Add these in Vercel too (as normal env vars, NOT NEXT_PUBLIC).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
