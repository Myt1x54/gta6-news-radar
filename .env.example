# ============================================================================
# GTA 6 News Radar - Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` (for local dev) and fill in real values.
# NEVER commit `.env`. In production these live in GitHub Secrets.
# The `web/` app uses its own `web/.env.local` (see web/.env.example later).
# ============================================================================

# ---- Supabase ----------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service role key (SECRET, full DB access). Used ONLY by the collector.
# Never expose this to the browser / frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Anon/public key (safe for the frontend). Kept here for local scripts/tests.
SUPABASE_ANON_KEY=

# ---- AI: Gemini (primary) ----------------------------------------------------
# Free tier. Flash / Flash-Lite models only (Pro is NOT free).
# As of 2026-09: recommended free-tier options (verify at the URL below):
#   gemini-3.5-flash-lite   -> GA, cheapest, high-volume (our default)
#   gemini-3-flash-preview  -> explicitly has a free tier, more capable
# NOTE: Gemini 2.5 models are now limited to accounts that used them before,
#       so do NOT pick a 2.5 model for a fresh API key.
# Verify current free model names at https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- AI: Groq (fallback) -----------------------------------------------------
# Free tier, OpenAI-compatible API. Used when Gemini returns 429/errors.
# As of 2026-09 the chat models available are: openai/gpt-oss-120b (default,
# most capable), openai/gpt-oss-20b (lighter), qwen/qwen3.8-27b.
# Verify current names at https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Email (Gmail SMTP via App Password) ------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
# Where alerts + digests are sent (can equal SMTP_USER)
ALERT_TO=your_gmail_address@gmail.com

# ---- YouTube Data API v3 -----------------------------------------------------
# Free quota: 10,000 units/day.
YOUTUBE_API_KEY=

# ---- Reddit OAuth (app-only, read-only) --------------------------------------
# Reddit blocks its public .json from datacenter IPs; OAuth fixes that AND
# returns upvote/comment counts. Create a "script" app at
# https://www.reddit.com/prefs/apps  (redirect uri can be http://localhost:8080).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Runtime / behaviour -----------------------------------------------------
# User-Agent sent when fetching feeds/pages. Be honest and identifiable.
USER_AGENT=GTA6NewsRadar/0.1 (+https://github.com/YOUR_USERNAME/gta6-news-radar)
# Timezone used for quiet hours / digest scheduling (PKT = Asia/Karachi).
APP_TIMEZONE=Asia/Karachi
# rank_score threshold (0-100) above which a breaking alert email is sent.
ALERT_THRESHOLD=75
# Deployed dashboard base URL, used for links in emails (defaults to this).
DASHBOARD_URL=https://gta6-news-radar.vercel.app
